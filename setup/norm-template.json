{
  "index_patterns": [
    "norm-*"
  ],
  "template": {
    "settings": {
      "number_of_replicas": 0
    },
    "mappings": {
      "dynamic_templates": [
        {
          "strings": {
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword"
            }
          }
        }
      ],
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "event": {
          "properties": {
            "dataset": {
              "type": "keyword"
            },
            "action": {
              "type": "keyword"
            }
          }
        },
        "log": {
          "properties": {
            "level": {
              "type": "keyword"
            }
          }
        },
        "source": {
          "properties": {
            "ip": {
              "type": "ip"
            }
          }
        },
        "host": {
          "properties": {
            "ip": {
              "type": "ip"
            },
            "name": {
              "type": "keyword"
            }
          }
        },
        "user": {
          "properties": {
            "name": {
              "type": "keyword"
            }
          }
        },
        "url": {
          "properties": {
            "original": {
              "type": "wildcard"
            }
          }
        },
        "user_agent": {
          "properties": {
            "original": {
              "type": "keyword"
            }
          }
        },
        "http": {
          "properties": {
            "request": {
              "properties": {
                "method": {
                  "type": "keyword"
                }
              }
            },
            "response": {
              "properties": {
                "status_code": {
                  "type": "long"
                },
                "bytes": {
                  "type": "long"
                },
                "time_ms": {
                  "type": "long"
                }
              }
            }
          }
        },
        "process": {
          "properties": {
            "name": {
              "type": "keyword"
            },
            "command_line": {
              "type": "wildcard"
            }
          }
        }
      }
    }
  }
}