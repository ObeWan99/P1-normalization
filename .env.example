# Скопируйте в .env и придумайте свои значения:  cp .env.example .env
# Пароли — не короче 6 символов, только латинские буквы и цифры, без пробелов и кавычек.

# Пароль пользователя elastic — с ним вы входите в Kibana и обращаетесь к Elasticsearch
ELASTIC_PASSWORD=
# Пароль служебной учётки kibana_system — его вы зададите в Elasticsearch на шаге 3
KIBANA_PASSWORD=
# Ключ шифрования Kibana: не короче 32 символов. Получить:  openssl rand -hex 16
ENCRYPTION_KEY=
